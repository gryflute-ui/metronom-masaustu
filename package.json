{
  "name": "metronom-masaustu",
  "productName": "Metronom",
  "version": "1.0.0",
  "description": "Alt bölüm destekli masaüstü metronom",
  "author": "Metronom",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.metronom.masaustu",
    "productName": "Metronom",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "metronom.html",
      "simge.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Metronom",
      "installerLanguages": ["tr_TR"],
      "language": "1055",
      "artifactName": "Metronom-Kurulum-${version}.${ext}"
    }
  }
}
